<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
<class>MainWindow</class>
<widget class="QMainWindow" name="MainWindow">
<property name="geometry"><rect><x>0</x><y>0</y><width>1600</width><height>950</height></rect></property>
<property name="windowTitle"><string>Petrophysics Professional - Integrated Well Log Analysis</string></property>
<property name="styleSheet"><string notr="true">
QMainWindow {
    background-color: #f0f4f8;
}
QMenuBar {
    background-color: #1a3a5c;
    color: white;
    font-size: 13px;
    padding: 2px 4px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #2d6a9f;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #c0cfe0;
    color: #1a3a5c;
}
QMenu::item:selected {
    background-color: #d0e4f7;
    color: #1a3a5c;
}
QToolBar {
    background-color: #2d6a9f;
    border: none;
    spacing: 4px;
    padding: 3px;
}
QToolBar QToolButton {
    background-color: rgba(255,255,255,0.15);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 4px;
    padding: 4px 8px;
}
QToolBar QToolButton:hover {
    background-color: rgba(255,255,255,0.3);
}
QStatusBar {
    background-color: #1a3a5c;
    color: white;
    font-size: 12px;
}
QTabWidget::pane {
    border: 1px solid #b0c4de;
    background-color: #ffffff;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #d0e4f7;
    color: #1a3a5c;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #b0c4de;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #2d6a9f;
    color: white;
}
QGroupBox {
    border: 1px solid #2d6a9f;
    border-radius: 6px;
    margin-top: 18px;
    padding: 6px;
    background-color: #f8fbff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    background-color: #2d6a9f;
    color: white;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton {
    background-color: #2d6a9f;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #1a5a8f;
}
QPushButton:pressed {
    background-color: #0f4070;
}
QPushButton[danger="true"] {
    background-color: #c0392b;
}
QPushButton[danger="true"]:hover {
    background-color: #a93226;
}
QPushButton[success="true"] {
    background-color: #27ae60;
}
QPushButton[success="true"]:hover {
    background-color: #219a52;
}
QPushButton[warning="true"] {
    background-color: #e67e22;
}
QPushButton[warning="true"]:hover {
    background-color: #ca6f1e;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    border: 1px solid #b0c4de;
    border-radius: 4px;
    padding: 4px 6px;
    background-color: white;
    color: #1a3a5c;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #2d6a9f;
}
QTreeView, QTableWidget, QListWidget {
    border: 1px solid #b0c4de;
    border-radius: 4px;
    background-color: white;
    alternate-background-color: #eef4fb;
    color: #1a3a5c;
}
QHeaderView::section {
    background-color: #2d6a9f;
    color: white;
    padding: 4px;
    border: none;
}
QScrollArea {
    border: 1px solid #b0c4de;
    border-radius: 4px;
    background-color: #f8fbff;
}
QTextEdit {
    border: 1px solid #b0c4de;
    border-radius: 4px;
    background-color: white;
    color: #1a3a5c;
}
QCheckBox {
    color: #1a3a5c;
    spacing: 6px;
}
QLabel {
    color: #1a3a5c;
}
QProgressBar {
    border: 1px solid #b0c4de;
    border-radius: 4px;
    background-color: #eef4fb;
    text-align: center;
    color: #1a3a5c;
}
QProgressBar::chunk {
    background-color: #2d6a9f;
    border-radius: 4px;
}
QSplitter::handle {
    background-color: #b0c4de;
}
</string></property>
